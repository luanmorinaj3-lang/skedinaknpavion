# API-Football v3 Key (Required for live scores, fixtures, odds, and match statistics)
API_FOOTBALL_KEY="YOUR_API_FOOTBALL_V3_KEY"

# Server session signing secret (set a strong random string in production)
SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# Initial Admin Account Credentials (seeded if no admin exists yet)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangeMeAdmin123!"

# Server Port (defaults to 3000; Replit Autoscale sets PORT automatically)
PORT=3000

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional: Google Search Console HTML meta verification token
GOOGLE_SITE_VERIFICATION=""
